{
  "name": "md",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "description": "WeChat Markdown Editor | 一款高度简洁的微信 Markdown 编辑器：支持 Markdown 语法、自定义主题样式、内容管理、多图床、AI 助手等特性",
  "homepage": "https://github.com/doocs/md",
  "repository": {
    "type": "git",
    "url": "https://github.com/doocs/md"
  },
  "bugs": {
    "url": "https://github.com/doocs/md/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "bun@1.2.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun install && bun run --cwd apps/web build && rm -rf dist && mv apps/web/dist dist",
    "start": "bun run --cwd apps/web dev",
    "web": "bun run --cwd apps/web",
    "vscode": "bun run --cwd apps/vscode",
    "vscode:test": "bun run --cwd apps/vscode test",
    "mcp": "bun run --cwd packages/mcp-server",
    "api": "bun run --cwd apps/api",
    "cli": "bun run --cwd packages/md-cli",
    "build:cli": "bun run --cwd apps/web build && bunx shx rm -rf packages/md-cli/dist && bunx shx rm -rf dist/**/*.map && bunx shx cp -r apps/web/dist packages/md-cli/ && bun run --cwd packages/md-cli pack",
    "release:cli": "bun run scripts/release.js",
    "lint": "bunx eslint . --fix",
    "type-check": "bun run type-check:web && bun run type-check:packages",
    "type-check:web": "bun run --cwd apps/web type-check",
    "type-check:packages": "bun run --cwd packages/core type-check && bun run --cwd packages/shared type-check && bun run --cwd apps/api type-check && bun run --cwd packages/mcp-server type-check && bun run --cwd apps/vscode type-check",
    "test": "bun run --cwd packages/core test && bun run --cwd apps/web test && bun run --cwd apps/api test",
    "postinstall": "bun run scripts/postinstall.mjs",
    "inspector": "bunx node-modules-inspector",
    "utools:package": "bun run scripts/package-utools.mjs",
    "link-claude-skills": "bun run scripts/link-claude-skills.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@types/node": "^26.1.1",
    "archiver": "^8.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.1.1",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign",
    "core-js",
    "esbuild",
    "keytar",
    "sharp",
    "simple-git-hooks",
    "spawn-sync",
    "vue-demi",
    "workerd"
  ],
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@hono/node-server": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/project-service": "8.65.0",
    "@typescript-eslint/rule-tester": "8.65.0",
    "@typescript-eslint/scope-manager": "8.65.0",
    "@typescript-eslint/tsconfig-utils": "8.65.0",
    "@typescript-eslint/type-utils": "8.65.0",
    "@typescript-eslint/types": "8.65.0",
    "@typescript-eslint/typescript-estree": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "@typescript-eslint/visitor-keys": "8.65.0",
    "@webext-core/isolated-element": "1.1.4",
    "adm-zip": "^0.6.0",
    "ajv@^8": "^8.20.0",
    "bn.js": ">=5.2.5",
    "bn.js@^5": "^5.2.5",
    "confbox": "0.2.4",
    "core-js": "^3.49.0",
    "cross-spawn@<7": "^7.0.6",
    "crypto-browserify": "npm:empty-module@0.0.2",
    "dompurify": "^3.4.12",
    "esbuild": ">=0.28.1",
    "fast-uri": "^3.1.4",
    "flatted@<3.4.0": "^3.4.2",
    "glob@<8": "^13.0.6",
    "glob@^10": "^13.0.6",
    "glob@^11": "^11.1.0",
    "inflight": "npm:@hishprorg/voluptates-laborum@^2.0.0",
    "ini": ">=7.0.0",
    "js-yaml": "^4.3.0",
    "jsdom>undici": "^7.25.0",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.3.0",
    "minimatch": "^10.2.5",
    "minimatch@^10": "^10.2.5",
    "minimatch@^5": "^10.2.5",
    "minimatch@^9": "^10.2.5",
    "prettier": "2.8.8",
    "qs": "^6.15.3",
    "querystring": "npm:qs@^6.15.3",
    "semver": "^7.8.5",
    "serialize-javascript@<7.0.3": "^7.0.7",
    "sharp": "^0.35.0",
    "shell-quote": "^1.10.0",
    "source-map@0.8.0-beta.0": "0.7.4",
    "tinyexec": "1.2.4",
    "tmp": ">=0.2.7",
    "underscore@<1.13.8": "1.13.8",
    "undici@^6": "^8.8.0",
    "undici@^7": "^8.8.0",
    "uuid": "^14.0.1",
    "workbox-build>source-map": "0.7.4",
    "ws@<8.21.0": "^8.21.1",
    "yauzl": "^3.4.0"
  }
}
